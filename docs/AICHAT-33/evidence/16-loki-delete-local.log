# AICHAT-249 · scripts/gdpr/loki-delete.ts against grafana/loki:3.7.8 (observability/loki.yml mounted), 2026-10-04
# 5 Faro-like lines pushed: 3 with correlation_id=3f2b1c9e-... (user A), 2 with correlation_id=9a7d0e11-... (user B)

## run 1: Loki with the repo config (delete_request_cancel_period 1h)
$ LOKI_URL=http://localhost:3199 node scripts/gdpr/loki-delete.ts --id 3f2b1c9e-6d7a-4e0b-9c1d-2a8f5e4b7c60
query: {app_name=~".+"} |= "3f2b1c9e-6d7a-4e0b-9c1d-2a8f5e4b7c60"
range: 2026-09-27T14:23:21.000Z .. 2026-10-04T14:23:22.000Z
matching lines now: 3
dry run: nothing deleted (add --yes to submit the delete request)
exit=0
$ ... --id 3f2b1c9e-6d7a-4e0b-9c1d-2a8f5e4b7c60 --yes
matching lines now: 3
delete request accepted; Loki filters the lines from queries now and purges them after the cancel period
exit=0
$ ... --list
[
  {
    "request_id": "f5ee9394",
    "start_time": 1790519001,
    "end_time": 1791123802,
    "query": "{app_name=~\".+\"} |= \"3f2b1c9e-6d7a-4e0b-9c1d-2a8f5e4b7c60\"",
    "status": "received",
