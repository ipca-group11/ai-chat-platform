{
  "name": "@platform/test-utils",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Shared Vitest helpers for the microfrontends: render helpers with a QueryClient, a fake EventSource and MSW handlers for the platform APIs.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./msw": "./src/msw/index.ts",
    "./pii": "./src/pii.ts",
    "./setup": "./src/setup.ts"
  },
  "scripts": {
    "build": "echo 'test-utils ships TypeScript source used by Vitest; nothing to build'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/react": "^16.3.3",
    "msw": "^2.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@platform/mock-server": "workspace:*"
  },
  "devDependencies": {
    "@app/shared-types": "workspace:*",
    "@platform/eslint-config": "workspace:*",
    "@platform/test-config": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
