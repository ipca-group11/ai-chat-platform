{
  "name": "@platform/test-config",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "echo 'test-config ships plain JavaScript with .d.ts files; nothing to build'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vitest": "^5.0.1"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "types": "./index.d.ts"
}
