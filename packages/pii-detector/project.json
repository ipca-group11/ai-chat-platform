{
  "name": "pii-detector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/pii-detector/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint src --max-warnings=0", "cwd": "packages/pii-detector" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json --noEmit", "cwd": "packages/pii-detector" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --coverage", "cwd": "packages/pii-detector" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'pii-detector ships TypeScript source used by Vitest; nothing to build'",
        "cwd": "packages/pii-detector"
      }
    }
  }
}
