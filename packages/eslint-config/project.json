{
  "name": "eslint-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/eslint-config/src",
  "projectType": "library",
  "tags": ["type:package", "scope:shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "packages/eslint-config"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "packages/eslint-config"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'eslint-config is plain JS; nothing to build'",
        "cwd": "packages/eslint-config"
      }
    }
  }
}
