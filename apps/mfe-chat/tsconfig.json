{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Module Federation DTS generation walks into packages/shared-types, outside src/.
    "rootDir": "../..",
    "paths": {
      "@app/shared-types/model-capabilities": ["../../packages/shared-types/src/model-capabilities.ts"],
      "@app/shared-types/stream-events": ["../../packages/shared-types/src/stream-events.ts"]
    },
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src"]
}
