{
  "name": "@app/mfe-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat microfrontend (chat list, chat view, composer, queue, attachments). Registered as a Module Federation remote consumed by apps/shell.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "cross-env NODE_ENV=test vitest run --coverage",
    "test:watch": "cross-env NODE_ENV=test vitest"
  },
  "dependencies": {
    "@app/ui": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10",
    "remark-gfm": "^4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.22.1",
    "@platform/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^7.0.3",
    "jsdom": "^30.1.1",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
