                x1="12"
                x2="12"
                y1="8"
                y2="12"
              />
              <line
                x1="12"
                x2="12.01"
                y1="16"
                y2="16"
              />
            </svg>
            <div
              class="col-start-2 line-clamp-1 min-h-4 font-medium tracking-tight"
              data-slot="alert-title"
            >
              <h1>
                Chat not found
              </h1>
            </div>
            <div
              class="col-start-2 grid justify-items-start gap-1 text-sm text-muted-foreground [&_p]:leading-relaxed"
              data-slot="alert-description"
            >
              <p>
                Chat not found. It may have been deleted, or you no longer have access to it.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
`;

