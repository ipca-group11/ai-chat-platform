# Local overrides for the shell's Module Federation remote URLs.
# Copy to `.env.local` (git-ignored) and adjust as needed; unset vars fall
# back to the localhost defaults in `module-federation.config.ts`.

# apps/mfe-auth dev server (default: http://localhost:5001)
VITE_MFE_AUTH_URL=http://localhost:5001

# apps/mfe-chat dev server (default: http://localhost:5002)
VITE_MFE_CHAT_URL=http://localhost:5002

# apps/mfe-settings dev server (default: http://localhost:5003)
VITE_MFE_SETTINGS_URL=http://localhost:5003
