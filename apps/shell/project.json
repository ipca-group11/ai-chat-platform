{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "tags": ["scope:shell", "type:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "apps/shell"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b --noEmit",
        "cwd": "apps/shell"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "apps/shell"
      }
    },
    "pact:consumer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run -c vitest.pact.config.ts",
        "cwd": "apps/shell"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/shell"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "size": {
      "executor": "nx:run-commands",
      "options": { "command": "size-limit", "cwd": "apps/shell" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/shell"
      }
    }
  }
}
