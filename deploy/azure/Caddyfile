# TLS front door for the Azure VM. Caddy gets a Let's Encrypt cert for {$DOMAIN} and
# serves the shell on 443 plus the three Module Federation remotes on their own ports
# (the shell loads them from https://{$DOMAIN}:300x, baked in at image-build time).
#
# Vite's preview server only answers requests whose Host is localhost and only sends CORS
# headers to localhost origins, so Host is rewritten upstream and CORS for the remotes is
# set here instead.

# Security headers (H8): applied to the shell and every remote. The CSP is a default (?) so
# Grafana, which sends its own policy under /grafana, keeps it.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		?Content-Security-Policy "default-src 'self'; script-src 'self' https://{$DOMAIN}:3001 https://{$DOMAIN}:3002 https://{$DOMAIN}:3003; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
}

# Access logs (privacy): JSON to stdout with the query string stripped from the URI and
# every client address field (remote/client IP, port, X-Forwarded-For) removed, so no raw IPs
# or query-string values (tokens, search text) reach the logs.
(accesslog) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.* ""
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers>X-Forwarded-For delete
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
}

(remote) {
	import security
	header Access-Control-Allow-Origin "https://{$DOMAIN}"
	header Vary Origin
	header -Server
}

{$DOMAIN} {
	import security
	import accesslog
	encode gzip
	# Grafana serves itself under /grafana (GF_SERVER_SERVE_FROM_SUB_PATH), so the prefix
	# is passed through unchanged.
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	# Grafana Faro browser telemetry -> Alloy's faro.receiver (same origin, so no CORS).
	handle /collect* {
		reverse_proxy alloy:12347
	}
	handle {
		reverse_proxy shell:3000 {
			header_up Host localhost
		}
	}
}

{$DOMAIN}:3001 {
	import remote
	import accesslog
	reverse_proxy mfe-auth:3001 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}

{$DOMAIN}:3002 {
	import remote
	import accesslog
	reverse_proxy mfe-chat:3002 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}

{$DOMAIN}:3003 {
	import remote
	import accesslog
	reverse_proxy mfe-settings:3003 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}
