# TLS front door for the Azure VM. Caddy gets a Let's Encrypt cert for {$DOMAIN} and
# serves the shell on 443 plus the three Module Federation remotes on their own ports
# (the shell loads them from https://{$DOMAIN}:300x, baked in at image-build time).
#
# Vite's preview server only answers requests whose Host is localhost and only sends CORS
# headers to localhost origins, so Host is rewritten upstream and CORS for the remotes is
# set here instead.

# Security headers for every answer, shell and remotes (AICHAT-228). HSTS starts at one
# day; raise it to a year (31536000) once the deploy has run with it for a while.
(security) {
	header {
		Strict-Transport-Security "max-age=86400; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Access log without personal data (AICHAT-232): client addresses are cut to their network
# (IPv4 /16, IPv6 /32), the query string is dropped from the URI and the headers that can
# carry an address or a full URL (Referer, forwarding headers, a redirect's Location) are
# removed. Cookie and Authorization are already redacted
# by Caddy. Written to stderr, so `docker compose logs caddy` shows it.
(access_log) {
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>remote_port delete
				request>uri regexp "\?.*$" ""
				request>headers>Referer delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
				resp_headers>Location delete
			}
		}
	}
}

(remote) {
	import security
	import access_log
	header Access-Control-Allow-Origin "https://{$DOMAIN}"
	header Vary Origin
	# The shell loads remoteEntry.js and the chunks from another origin (port 443).
	header Cross-Origin-Resource-Policy "cross-origin"
	header X-Frame-Options "DENY"
}

{$DOMAIN} {
	encode gzip
	import security
	import access_log
	# Routes of the services that browsers must never reach through the shell's /api proxy:
	# Prometheus scrapes /metrics inside the compose network (AICHAT-229), and /internal is
	# the service-to-service API (account erasure) that auth-service calls directly
	# (AICHAT-248). Caddy's path matcher ignores case, like Express's router.
	@private path /api/metrics* /api/internal /api/internal/*
	handle @private {
		respond 404
	}
	# Grafana serves itself under /grafana (GF_SERVER_SERVE_FROM_SUB_PATH), so the prefix
	# is passed through unchanged.
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	# Grafana Faro browser telemetry -> Alloy's faro.receiver (same origin, so no CORS).
	# The client address is not passed on, so Alloy and Loki never see it (AICHAT-233).
	handle /collect* {
		reverse_proxy alloy:12347 {
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
			header_up -Forwarded
		}
	}
	handle {
		# The shell's own headers (Grafana above keeps its own). The CSP is Report-Only
		# until a browser session shows no violations; then rename it to
		# Content-Security-Policy. Triage: docs/AICHAT-28/WORKLOG.md (US4).
		header {
			Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://{$DOMAIN}:3001 https://{$DOMAIN}:3002 https://{$DOMAIN}:3003; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://{$DOMAIN}:3001 https://{$DOMAIN}:3002 https://{$DOMAIN}:3003; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
		}
		reverse_proxy shell:3000 {
			header_up Host localhost
		}
	}
}

{$DOMAIN}:3001 {
	import remote
	reverse_proxy mfe-auth:3001 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}

{$DOMAIN}:3002 {
	import remote
	reverse_proxy mfe-chat:3002 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}

{$DOMAIN}:3003 {
	import remote
	reverse_proxy mfe-settings:3003 {
		header_up Host localhost
		header_down -Access-Control-Allow-Origin
	}
}
