{
  "openapi": "3.1.0",
  "info": {
    "title": "auth-service",
    "version": "1.0.0",
    "description": "Accounts and sessions. Generated from the Zod schemas; do not edit by hand."
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "Local service (the shell proxies /auth to it)"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "Access token (JWT, 15 min) set by login and refresh"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "Refresh token (7 days), only sent to /auth"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "email"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "operations"
        ],
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is up",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": [
          "operations"
        ],
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Prometheus text format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "tags": [
          "auth"
        ],
        "summary": "Create an account (does not sign in)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "pattern": "[A-Za-z]"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new account",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: `VALIDATION_ERROR` with `fieldErrors`",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": [
          "auth"
        ],
        "summary": "Sign in; the tokens come back as httpOnly cookies",
        "description": "An invalid body is answered like wrong credentials (401), never with field errors, so a caller cannot learn which field was wrong (AC-36).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "`access_token` (path /) and `refresh_token` (path /auth), both httpOnly, SameSite=Lax",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials, session or refresh token",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "tags": [
          "auth"
        ],
        "summary": "Rotate the refresh token and issue a new access token",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "New cookies set",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "`access_token` (path /) and `refresh_token` (path /auth), both httpOnly, SameSite=Lax",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials, session or refresh token",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "summary": "Sign out: revoke the refresh token, clear the cookies and stop the user's replies",
        "security": [
          {
            "refreshCookie": []
          },
          {}
        ],
        "responses": {
          "204": {
            "description": "Signed out (also without a session)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Expires both auth cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials, session or refresh token",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAccount",
        "tags": [
          "auth"
        ],
        "summary": "Erase the account and everything it owns; the password is asked again",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Erased; cookies cleared",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Expires both auth cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: `VALIDATION_ERROR` with `fieldErrors`",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials, session or refresh token",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The request comes from an origin that is not allowed",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client (`RATE_LIMITED`)",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "conversation-service did not erase the account's data; nothing was deleted",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Account deletion is not configured on this deployment",
            "headers": {
              "X-Correlation-Id": {
                "description": "Echoes the request's correlation id, or a new one",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
