# auth-service environment variables (merge into the root .env.example owned by platform)

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth?schema=public"

# Port the HTTP server listens on.
PORT=4001

# Shared HS256 secret used to sign/verify access token JWTs. Must be identical to the
# value `conversation-service` uses to verify tokens locally (ARCHITECTURE.md §4).
JWT_SECRET="change-me-in-every-environment"

# Origin(s) allowed by CORS (comma-separated), e.g. the shell app's origin.
CORS_ORIGIN="http://localhost:3000"

# Whether cookies are set with the `Secure` attribute. Must be "true" in every
# environment where the app is served over HTTPS (all non-local environments); only
# disable for plain-http local development.
COOKIE_SECURE=true

# Account deletion (DELETE /auth/me) asks conversation-service to erase the user's chats first. Both values
# are needed; without them the endpoint answers 503 and deletes nothing. The token is at least 32
# characters, the same value as in conversation-service. Example: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=
# CONVERSATION_SERVICE_URL=http://localhost:4002

# How often the retention job runs, in minutes (default 360); 0 turns it off. It deletes refresh tokens 7 days
# after they expire and accounts idle for 24 months (docs/AICHAT-33/RETENTION.md).
RETENTION_INTERVAL_MINUTES=360

NODE_ENV=development
LOG_LEVEL=info
