{
  "name": "@app/conversation-service",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:stop-abort": "vitest run src/integration/stop-abort.spec.ts",
    "openapi:generate": "vitest run src/openapi/openapi.spec.ts -u",
    "test-db": "vitest run --config vitest.db.config.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@app/shared-types": "workspace:*",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/client": "6.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@platform/eslint-config": "workspace:*",
    "@platform/pact-config": "workspace:^",
    "@platform/pii-detector": "workspace:*",
    "@platform/test-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "5.0.1",
    "prisma": "6.1.0",
    "supertest": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
