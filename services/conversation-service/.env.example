# conversation-service environment variables (merge into the root .env.example owned by platform)

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conversation?schema=public"

# Port the HTTP server listens on.
PORT=4002

# Shared HS256 secret used to verify access token JWTs issued by auth-service. Must be
# identical to the value `auth-service` uses to sign tokens (ARCHITECTURE.md §4,
# STACK.md decision #1). No network call to auth-service is made per request.
JWT_SECRET="change-me-in-every-environment"

# Origin(s) allowed by CORS (comma-separated), e.g. the shell app's origin.
CORS_ORIGIN="http://localhost:3000"

# Directory (Docker volume) where uploaded attachments are stored on disk
# (ARCHITECTURE.md §5, STACK.md decision #3).
UPLOAD_DIR="./data/uploads"

# Maximum accepted attachment size in bytes (FR15). Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# Ollama base URL used by the Ollama provider adapter.
OLLAMA_BASE_URL="http://localhost:11434"

# Default Ollama model pre-pulled by docker-compose (STACK.md decision #7).
OLLAMA_DEFAULT_MODEL="llama3.2:1b"

NODE_ENV=development
LOG_LEVEL=info
