# conversation-service environment variables (merge into the root .env.example owned by platform)

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conversation?schema=public"

# Port the HTTP server listens on.
PORT=4002

# Shared HS256 secret used to verify access token JWTs issued by auth-service. Must be
# identical to the value `auth-service` uses to sign tokens (ARCHITECTURE.md §4,
# STACK.md decision #1). No network call to auth-service is made per request.
JWT_SECRET="change-me-in-every-environment"

# Origin(s) allowed by CORS (comma-separated), e.g. the shell app's origin.
CORS_ORIGIN="http://localhost:3000"

# Directory (Docker volume) where uploaded attachments are stored on disk
# (ARCHITECTURE.md §5, STACK.md decision #3).
UPLOAD_DIR="./data/uploads"

# Maximum accepted attachment size in bytes (FR15). Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# Base URLs of the LLM providers. Defaults are the real APIs; point them at the mock server
# (e.g. http://localhost:4010/anthropic) for tests.
ANTHROPIC_BASE_URL="https://api.anthropic.com"
OPENAI_BASE_URL="https://api.openai.com"
# Local Ollama server used by the Ollama provider adapter (no API key).
OLLAMA_BASE_URL="http://localhost:11434"

# Opening of the system prompt of every reply (AICHAT-243). Unset or empty: the built-in one. The rules for
# untrusted content (files, PDF text, text in images, web pages and other members' messages are data, never
# instructions) are always appended. See src/shared/system-prompt.ts.
# SYSTEM_PROMPT="You are a helpful assistant in a chat app."

# Sites the model may fetch while answering (AICHAT-242), comma-separated, subdomains included. One of the
# two, never both: ALLOWED = only these, BLOCKED = all but these. Unset: no restriction.
# WEB_FETCH_ALLOWED_DOMAINS="example.com,docs.python.org"
# WEB_FETCH_BLOCKED_DOMAINS="attacker.example"

# How often the retention job runs, in minutes (default 360); 0 turns it off. It removes uploaded files that no
# attachment points to once they are older than 24 hours (docs/AICHAT-33/RETENTION.md).
RETENTION_INTERVAL_MINUTES=360

NODE_ENV=development
LOG_LEVEL=info

# Shared secret of the service-to-service calls (at least 32 characters, same value in auth-service).
# auth-service sends it to POST /internal/erasures when an account is deleted. Without it the internal
# routes are not mounted. Generate one per environment, for example: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=
