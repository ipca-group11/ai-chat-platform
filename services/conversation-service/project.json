{
  "name": "conversation-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/conversation-service/src",
  "projectType": "application",
  "tags": ["type:service", "scope:chat"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "services/conversation-service"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate",
        "cwd": "services/conversation-service"
      },
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "services/conversation-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "options": {
        "command": "vitest run --coverage",
        "cwd": "services/conversation-service"
      }
    },
    "pact:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "options": {
        "command": "vitest run -c vitest.verify.config.ts",
        "cwd": "services/conversation-service"
      }
    },
    "test-db": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "options": {
        "command": "vitest run --config vitest.db.config.ts",
        "cwd": "services/conversation-service"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "services/conversation-service"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch src/server.ts",
        "cwd": "services/conversation-service"
      },
      "cache": false
    }
  }
}
