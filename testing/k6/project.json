{
  "name": "k6",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "testing/k6",
  "projectType": "application",
  "tags": [
    "type:perf",
    "scope:shared"
  ],
  "targets": {
    "perf": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash testing/k6/run.sh smoke"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "testing/k6"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "testing/k6"
      }
    }
  }
}
