# mock-server environment variables (all optional)

# Port the HTTP server listens on.
PORT=4010

# Fixed delay added to every mock response, in milliseconds.
LATENCY_MS=0

# LLM mocks: time to first token and gap between tokens, in milliseconds.
TTFT_MS=200
TOKEN_INTERVAL_MS=20

# LLM mocks: number of tokens in a default answer.
TOKENS=40

# Share of mock requests (0 to 1) that fail with a 500 at random.
ERROR_RATE=0

# Seed of the pseudo-random generator, so a run can be repeated exactly.
SEED=1

# LLM replay (scenario replay:<fixture>): folder with anthropic/*.sse and openai/*.sse.
# Default: the AICHAT-25 recordings in services/conversation-service (found from the repo root).
# FIXTURES_DIR=

# Dataset loaded at start-up (empty, default, many-chats, long-conversation, shared-chats, attachments).
MOCK_DATASET=empty
