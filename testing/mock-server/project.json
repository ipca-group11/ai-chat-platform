{
  "name": "mock-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "testing/mock-server/src",
  "projectType": "application",
  "tags": ["type:service", "scope:mock"],
  "implicitDependencies": ["conversation-service"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "testing/mock-server"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "testing/mock-server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "testing/mock-server"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build.mjs",
        "cwd": "testing/mock-server"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch src/main.ts",
        "cwd": "testing/mock-server"
      },
      "cache": false
    }
  }
}
