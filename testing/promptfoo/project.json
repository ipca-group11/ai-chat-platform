{
  "name": "promptfoo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "testing/promptfoo/src",
  "projectType": "application",
  "tags": ["type:test", "scope:redteam"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint src --max-warnings=0", "cwd": "testing/promptfoo" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json --noEmit", "cwd": "testing/promptfoo" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --coverage", "cwd": "testing/promptfoo" }
    }
  }
}
