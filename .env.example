# Copy this file to `.env` for local `docker compose up`. Every variable has a safe
# local-only default; only real secrets (LLM provider API keys) are supplied per-request
# by the browser (FR19) and are never stored here. See docs/STACK.md §4 and
# docs/pods/platform-foundation/CONVENTIONS.md §5 for the port/env conventions.

# ---------------------------------------------------------------------------
# Node / general
# ---------------------------------------------------------------------------
NODE_ENV=development
# Header name every service/client reads-or-generates a correlation id from
# (STACK.md decision #8). Also exported as CORRELATION_HEADER from
# packages/shared-types/src/http.
CORRELATION_HEADER=X-Correlation-Id

# ---------------------------------------------------------------------------
# Postgres (shared instance, one schema per service)
# ---------------------------------------------------------------------------
POSTGRES_USER=llmchat
POSTGRES_PASSWORD=llmchat_local_dev
POSTGRES_DB=llmchat
POSTGRES_PORT=5432
# Full connection strings consumed by each service's own Prisma schema.
AUTH_SERVICE_DATABASE_URL=postgresql://llmchat:llmchat_local_dev@postgres:5432/llmchat?schema=auth
CONVERSATION_SERVICE_DATABASE_URL=postgresql://llmchat:llmchat_local_dev@postgres:5432/llmchat?schema=conversation

# ---------------------------------------------------------------------------
# Auth (STACK.md decisions #1, #2, #4)
# ---------------------------------------------------------------------------
# HS256 shared secret used by auth-service to sign, and conversation-service to
# verify, access tokens locally (no network round trip per request). Local dev only —
# generate a real secret per environment in production.
JWT_SECRET=local-dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Attachments (STACK.md decision #3)
# ---------------------------------------------------------------------------
# Local filesystem volume mounted into conversation-service; see docker-compose.yml.
UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------------------
# Service ports (see CONVENTIONS.md §5 for the full port table)
# ---------------------------------------------------------------------------
# Host port for the entry point published by compose.yaml (docs/DEPLOY.md), i.e.
# http://127.0.0.1:${APP_PORT}/. Not used by docker-compose.yml (which publishes `shell`
# on SHELL_PORT instead).
APP_PORT=8000
SHELL_PORT=3000
MFE_AUTH_PORT=3001
MFE_CHAT_PORT=3002
MFE_SETTINGS_PORT=3003
AUTH_SERVICE_PORT=4001
CONVERSATION_SERVICE_PORT=4002

# Base URLs the shell/mfe-* use to reach each backend service (same-origin behind the
# shell in production; direct ports for local dev).
AUTH_SERVICE_URL=http://localhost:4001
CONVERSATION_SERVICE_URL=http://localhost:4002

# ---------------------------------------------------------------------------
# Observability (STACK.md §3, decision area 6)
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
