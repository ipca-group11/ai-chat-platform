        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CLS p75 by page over time",
      "description": "Budget: 0.1 (0.05 on /login and /register) (AICHAT-45).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.75, {app_name=\"llm-chat\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | cls!=\"\" | label_format page=`{{ regexReplaceAll \"^https?://[^/]+(/[^/?]*).*$\" (regexReplaceAll \"^https?://[^/]+/chats/[^/?]+.*$\" .page_url \"/chats/:id\") \"${1}\" }}` | unwrap cls [5m]) by (page)",
          "legendFormat": "{{page}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
