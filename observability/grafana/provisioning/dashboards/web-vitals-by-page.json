      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Page loads measured by page",
      "description": "How many LCP measurements the p75 values above are based on.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (page) (count_over_time({app_name=\"llm-chat\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | lcp!=\"\" | label_format page=`{{ regexReplaceAll \"^https?://[^/]+(/[^/?]*).*$\" (regexReplaceAll \"^https?://[^/]+/chats/[^/?]+.*$\" .page_url \"/chats/:id\") \"${1}\" }}` [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "LCP samples"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "page": "Page"
            }
          }
        }
      ]
    }
  ]
}
