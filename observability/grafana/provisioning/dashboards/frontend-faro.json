      "description": "Faro signals received per kind (exception, log, event, measurement).",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (kind) (count_over_time({app_name=\"llm-chat\"}[$__interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
