{
  "name": "llm-chat-workspace",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.4.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:mock": "bash scripts/dev-mock.sh",
    "mock:up": "bash scripts/mock-compose.sh up",
    "mock:down": "bash scripts/mock-compose.sh down",
    "load:up": "LOAD=1 bash scripts/mock-compose.sh up llm",
    "nx": "nx",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "test:cov:floor": "nx test workspace-config -- coverage-guard",
    "test:headers": "nx test workspace-config -- caddy-headers",
    "test:a11y:components": "nx test mfe-chat -- a11y",
    "test:perf:streaming": "nx test mfe-chat -- streaming-perf",
    "test:res:sse-reconnect": "nx test mfe-chat -- sse-reconnect",
    "test:sec:authz": "nx test conversation-service -- authz",
    "test:sec:internal-route": "nx test conversation-service -- internal-route",
    "test:res:health-db": "nx test auth-service -- health",
    "test:sec:ratelimit": "nx test auth-service -- rate-limit",
    "test:sec:jwt-secret": "nx test conversation-service -- env",
    "test:sec:upload": "nx test conversation-service -- upload",
    "test:sec:metrics-auth": "nx test observability -- metrics-auth",
    "test:obs:dashboards": "nx test observability -- dashboards",
    "test:obs:config": "sh observability/check-config.sh",
    "test": "nx run-many -t test",
    "e2e": "nx run e2e:e2e",
    "build": "nx run-many -t build",
    "affected:lint": "nx affected -t lint",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "graph": "nx graph",
    "hooks:install": "sh scripts/git-hooks/install.sh",
    "sast": "bash scripts/ci/semgrep.sh semgrep-results && node scripts/ci/sast-summary.ts semgrep-results/semgrep.sarif"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@nx/eslint": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "nx": "23.3.0",
    "puppeteer-core": "^25.13.0",
    "size-limit": "^14.2.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux",
        "darwin"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc",
        "musl"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "nx",
      "prisma"
    ],
    "overrides": {
      "adm-zip": ">=0.6.1",
      "axios": ">=1.20.0",
      "basic-ftp": ">=6.2.1",
      "brace-expansion@5": ">=5.0.12",
      "smol-toml": ">=1.7.1",
      "source-map-js": ">=1.2.2",
      "tmp": ">=0.2.6",
      "undici@7": ">=7.29.1",
      "simple-git": ">=4.0.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
